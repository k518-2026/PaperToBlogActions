# ==========================================
# PaperToBlogActions Environment Settings
# ==========================================

# Google Gemini API Key (Required for summarization and image generation)
GEMINI_API_KEY=your_gemini_api_key_here

# WordPress Post by Email address (Required)
# e.g., secret_string_12345@post.wordpress.com
WP_POST_EMAIL=your_wordpress_post_email@post.wordpress.com

# SMTP Settings for Sending Emails (Required for Post by Email)
# Example for Gmail:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password

# Gemini Models Configuration (Optional, defaults provided)
GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Post Defaults
WP_POST_STATUS=publish
WP_CATEGORIES=情報教育,プログラミング教育,コンピューテーショナルシンキング
WP_TAGS=論文紹介,海外研究,教育工学,STEM教育
